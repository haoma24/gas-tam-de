                },
                "description": {
                    "type": "string"
                },
                "image_url": {
                    "type": "string"
                },
                "image_urls": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "name": {
                    "type": "string"
                },
                "sale_price": {
                    "type": "integer"
                },
                "sku": {
                    "type": "string"
                },
                "unit": {
                    "type": "string"
                }
            }
        },
        "main.helloResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "Gas Tam De API Gateway"
                },
                "status": {
                    "type": "string",
                    "example": "ok"
                }
            }
        },
        "main.patchProductBody": {
            "type": "object",
            "properties": {
                "active": {
                    "type": "boolean"
                },
                "description": {
                    "type": "string"
                },
                "image_url": {
                    "type": "string"
                },
                "image_urls": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "name": {
                    "type": "string"
                },
                "sale_price": {
                    "type": "integer"
                },
                "sku": {
                    "type": "string"
                },
                "unit": {
                    "type": "string"
                }
            }
        },
        "main.product": {
            "type": "object",
            "properties": {
                "active": {
                    "type": "boolean"
                },
                "created_at": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "image_url": {
                    "type": "string"
                },
                "image_urls": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "name": {
                    "type": "string"
                },
                "sale_price": {
                    "type": "integer"
                },
                "sku": {
                    "type": "string"
                },
                "unit": {
                    "type": "string"
