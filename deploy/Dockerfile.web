# Flutter Web build for apps/mobile, served by nginx (see deploy/nginx.web.conf).
# Build: docker build -f deploy/Dockerfile.web -t gas-tam-de/web .

# Must stay >= the Dart SDK that pubspec.lock resolves against (google_fonts
# 8.2.1 needs Dart ^3.10, i.e. Flutter 3.44+).
ARG FLUTTER_VERSION=3.44.0

FROM ghcr.io/cirruslabs/flutter:${FLUTTER_VERSION} AS build
WORKDIR /src

COPY apps/mobile/pubspec.yaml apps/mobile/pubspec.lock ./
RUN flutter pub get

COPY apps/mobile ./

# Empty base URL makes Dio issue same-origin relative requests, which nginx
# proxies to api-gateway. Override to call a gateway on another host.
ARG API_BASE_URL=""
RUN flutter build web --release --dart-define=API_BASE_URL="${API_BASE_URL}"

FROM nginx:1.27-alpine
RUN apk add --no-cache wget
COPY deploy/nginx.web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/build/web /usr/share/nginx/html
EXPOSE 80
