# Flutter Web build for apps/mobile, served by nginx (see deploy/nginx.web.conf).
# Embeds api-gateway on 127.0.0.1:8081 for VPS platforms that only run `web`.
# Build: docker build -f deploy/Dockerfile.web -t gas-tam-de/web .

ARG FLUTTER_VERSION=3.44.0
ARG ALPINE_VERSION=3.21

FROM golang:1.25-bookworm AS gobuild
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY pkg ./pkg
COPY services ./services
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/gas-api-gateway ./services/api-gateway

FROM ghcr.io/cirruslabs/flutter:${FLUTTER_VERSION} AS build
WORKDIR /src

COPY apps/mobile/pubspec.yaml apps/mobile/pubspec.lock ./
RUN flutter pub get

COPY apps/mobile ./

ARG API_BASE_URL=""
ARG GOOGLE_WEB_CLIENT_ID=""
ARG GOOGLE_IOS_CLIENT_ID=""
# --no-web-resources-cdn puts CanvasKit (the single biggest download of a first
# load) on our own origin: it then shares the page's TLS connection instead of
# costing a DNS + handshake to www.gstatic.com, and the site keeps working where
# gstatic is slow or filtered. Brotli below matches what the CDN would serve.
RUN flutter build web --release \
      --no-web-resources-cdn \
      --dart-define=API_BASE_URL="${API_BASE_URL}" \
      --dart-define=GOOGLE_WEB_CLIENT_ID="${GOOGLE_WEB_CLIENT_ID}" \
      --dart-define=GOOGLE_IOS_CLIENT_ID="${GOOGLE_IOS_CLIENT_ID}"

# Compress once here instead of per request: nginx dynamic gzip is level 1 and
# cannot do brotli at all. brotli -q 11 takes CanvasKit from 5.6 MB to ~1.6 MB.
FROM alpine:${ALPINE_VERSION} AS compress
RUN apk add --no-cache brotli gzip findutils
COPY --from=build /src/build/web /web
RUN find /web -type f -size +1k \
      \( -name '*.js' -o -name '*.mjs' -o -name '*.json' -o -name '*.css' \
         -o -name '*.html' -o -name '*.wasm' -o -name '*.svg' \
         -o -name '*.ttf' -o -name '*.otf' \) \
      -print0 \
      | xargs -0 -P 4 -I{} sh -c 'gzip -9 -kf "$1" && brotli -q 11 -kf "$1"' _ {}

# Alpine's nginx package ships a matching nginx-mod-http-brotli (the official
# nginx image has no brotli module), and auto-loads it from /etc/nginx/modules.
FROM alpine:${ALPINE_VERSION}
RUN apk add --no-cache nginx nginx-mod-http-brotli wget \
    && ln -sf /dev/stdout /var/log/nginx/access.log \
    && ln -sf /dev/stderr /var/log/nginx/error.log
COPY --from=gobuild /out/gas-api-gateway /usr/local/bin/gas-api-gateway
COPY deploy/docker-entrypoint.web.sh /docker-entrypoint.web.sh
RUN chmod +x /docker-entrypoint.web.sh
# http.d, not conf.d — on Alpine conf.d is included in the root context.
COPY deploy/nginx.web.conf /etc/nginx/http.d/default.conf
COPY --from=compress /web /usr/share/nginx/html
EXPOSE 8080
ENTRYPOINT ["/docker-entrypoint.web.sh"]
