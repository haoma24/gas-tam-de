# Multi-stage build for any Go service under services/<SERVICE>.
# Build: docker build -f deploy/Dockerfile.service --build-arg SERVICE=api-gateway -t gas-tam-de/api-gateway .

FROM golang:1.22-bookworm AS build
WORKDIR /src
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git && rm -rf /var/lib/apt/lists/*
COPY go.mod go.sum ./
RUN go mod download
COPY pkg ./pkg
COPY services ./services
ARG SERVICE=api-gateway
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/service ./services/${SERVICE}

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=build /out/service /app/service
EXPOSE 8080
ENTRYPOINT ["/app/service"]
