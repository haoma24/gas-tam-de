# Copy to deploy/.env (or repo-root .env) for docker compose / local runs.
# Do not commit secrets.
#
# --- VPS / staging deploy (docker compose --no-build) ---
# Service images are published to GHCR by the backend-ci.yml workflow on every
# push to stag. They are public — no registry credentials needed.
# The image names are hardcoded in docker-compose.yml (ghcr.io/haoma24/...:stag)
# so no extra environment variables are required for the image registry.
#
# Cursor Cloud / VPS project Environment: use deploy/.env.vps.example (minimal).
# Do NOT paste this whole local file into the VPS project env — local values like
# NATS_URL=127.0.0.1, *_SERVICE_URL=127.0.0.1, IMAGE_PREFIX, SERVICE, and
# GEOCODE_USER_AGENT with ": " break Stage 5 or override Docker DNS in containers.
#
# IMPORTANT — Cursor Cloud Stage 5 ("Run Container"):
# The deploy platform copies KEY=VALUE into an unquoted
# docker-compose.override.yml (`KEY: VALUE`). Do NOT put ": " (colon + space)
# inside any value — YAML will treat it as a nested mapping and fail with
# "did not find expected key". Validate with: make check-env-yaml
#
# --- Website in Docker (VPS / full stack) ---
# Website lives on WEB_PORT, NOT on GATEWAY (8080).
# Opening http://<host>:8080/ returns 404 — that is the API only.
# Correct URL after `make compose-up`:
#   http://<VPS_IP>:8090/
# Bind to port 80 instead (needs free host port / root or CAP_NET_BIND_SERVICE):
#   WEB_PORT=80
WEB_PORT=8090
# Leave empty = same-origin via nginx proxy to api-gateway (recommended).
# WEB_API_BASE_URL=
# FLUTTER_VERSION=3.44.0

GATEWAY_ADDR=:8080
GATEWAY_DB=data/gateway.db
# Flutter Web CORS (T9.1.1). Comma-separated; trailing * = prefix (localhost ports).
# Only needed when the browser calls the gateway on a *different* origin
# (e.g. flutter run -d chrome → :8080). The compose `web` service is same-origin.
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*
AUTH_ADDR=:8081
CATALOG_ADDR=:8082
GEO_ADDR=:8083
ORDER_ADDR=:8084
INVENTORY_ADDR=:8085
BILLING_ADDR=:8086
REPORT_ADDR=:8087

AUTH_DB=data/auth.db
CATALOG_DB=data/catalog.db
GEO_DB=data/geo.db
# Geocode proxy (T3.1.2): photon (default) | nominatim
GEOCODE_PROVIDER=photon
# GEOCODE_BASE_URL=https://photon.komoot.io
# GEOCODE_BASE_URL=https://nominatim.openstreetmap.org
# No ": " inside the value (see Cursor Cloud note above). Prefer contact=...
GEOCODE_USER_AGENT=GasTamDe/1.0 (local-dev; geo-service; contact=local)
GEOCODE_CACHE_TTL_HOURS=24
GEOCODE_MAX_PER_IP_MINUTE=30
# Store geo fence seed (T3.2.1) — singleton store_settings; not overwritten on restart.
# STORE_SEED=0 disables insert. Defaults ≈ Bến Thành HCMC for local.
STORE_SEED=1
STORE_NAME=Gas Tam Đệ
STORE_LAT=10.7769
STORE_LNG=106.7009
STORE_MAX_RADIUS_KM=10
# STORE_ADDRESS_TEXT=
ORDER_DB=data/order.db
# Delivery fee seed (T4.1.1) — singleton settings + architecture example bands; not overwritten on restart.
# DELIVERY_FEE_SEED=0 disables insert. DELIVERY_FEE_ENABLED=1 seeds with fee on (default off).
DELIVERY_FEE_SEED=1
DELIVERY_FEE_ENABLED=0
INVENTORY_DB=data/inventory.db
# Inventory seed (T7.1.1) — empty stock_items/movements by design; INVENTORY_SEED=0 skips readiness log.
INVENTORY_SEED=1
BILLING_DB=data/billing.db
REPORT_DB=data/report.db

# order-service upstreams (T3.3.1 validate geo+catalog; T3.3.2 publishes order.placed via NATS;
# T6.1.2 records payments/debts on billing-service after complete)
GEO_SERVICE_URL=http://127.0.0.1:8083
CATALOG_SERVICE_URL=http://127.0.0.1:8082
BILLING_SERVICE_URL=http://127.0.0.1:8086

NATS_URL=nats://127.0.0.1:4222
# How long catalog/order/inventory/billing/report wait for NATS JetStream at
# boot before exiting (restart policy then retries). Raise on a slow VPS if the
# deploy fails with "container ... is unhealthy". 0 = fail on first attempt.
NATS_STARTUP_TIMEOUT_SEC=60
INTERNAL_TOKEN=dev-internal-token-change-me
JWT_SECRET=dev-jwt-secret-change-me
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000
PHONE_ENC_KEY=dev-phone-enc-key-32bytes-min!!
PHONE_HASH_PEPPER=dev-phone-hash-pepper-change-me
OTP_HASH_PEPPER=dev-otp-hash-pepper-change-me
OTP_TTL_SEC=300
OTP_COOLDOWN_SEC=60
OTP_MAX_PER_PHONE_HOUR=5
OTP_MAX_PER_IP_HOUR=20
OTP_MAX_ATTEMPTS=5
# Gateway edge rate limits (T9.1.2) — sliding window per minute; 429 + Retry-After.
RATE_LIMIT_OTP_PER_IP_MINUTE=10
RATE_LIMIT_LOGIN_PER_IP_MINUTE=10
RATE_LIMIT_ORDER_PER_IP_MINUTE=30
RATE_LIMIT_ORDER_PER_USER_MINUTE=10
# 1 = include dev_code in OTP request response (local only; set 0 in production)
OTP_DEV_REVEAL=1
# SMS adapter: mock (default/local) | stringee | production (SMS_VENDOR chọn client)
SMS_PROVIDER=mock

# --- Stringee SMS REST (SMS_PROVIDER=stringee) ---
# Lấy API Key SID / Secret ở dashboard Stringee; SMS_SENDER là brandname đã được duyệt.
# SMS_API_SID=SKxxxxxxxxxxxxxxxx
# SMS_API_SECRET=
# SMS_SENDER=GASTAMDE
# Mặc định https://api.stringee.com/v1/sms — chỉ set khi cần override.
# SMS_API_URL=
# SMS_TIMEOUT_SEC=10
# SMS_JWT_TTL_SEC=3600

# --- Vendor khác (SMS_PROVIDER=production, chưa có client) ---
# SMS_VENDOR=esms
# SMS_API_KEY=          # cũng nhận dạng "sid:secret" cho Stringee nếu chỉ có 1 secret slot

# Admin bootstrap seed (T1.2.1) — local only; change before any shared/prod deploy.
# ADMIN_SEED=0 disables insert. Existing username is never overwritten on restart.
ADMIN_SEED=1
ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin-change-me
ADMIN_DISPLAY_NAME=Admin

