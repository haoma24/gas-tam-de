# Minimal env for Cursor Cloud / VPS staging deploy.
# Copy these keys into the project Environment UI (or deploy/.env on the VPS).
# Do NOT paste the full local deploy/.env.example — many local values break Stage 5
# or override Docker DNS inside containers.
#
# Rules:
# 1) Never put ": " (colon + space) inside a value — override YAML is unquoted.
# 2) Do NOT set NATS_URL / *_SERVICE_URL / *_ADDR / *_DB — compose already sets
#    the correct in-network values (nats://nats:4222, http://geo-service:8083, /data/*.db).
# 3) Do NOT set IMAGE_PREFIX / IMAGE_TAG / SERVICE / API_BASE_URL — unused or harmful.
# 4) Validate: ./scripts/check-env-yaml-safe.sh deploy/.env.vps.example
#
# Website via Traefik: labeledPort=8080 → service **web** (nginx). Main compose
# does not publish host ports. WEB_PORT only matters with docker-compose.local.yml.
# Coolify UI: Ports Exposes = 8080 (web), not api-gateway.
# Optional: CORS_ORIGINS=https://tamde-stag.tinhgon.xyz,http://localhost:*
#
# PROXY_NETWORK must match the platform Traefik network (default tensorship-net).
# Compose joins every service to that external network so nginx in `web` can reach
# api-gateway. If the network does not exist yet, `make ensure-proxy-net` or
# vps-compose-up.sh creates it on first deploy.

WEB_PORT=8090
FLUTTER_VERSION=3.44.0
# Leave empty = same-origin via nginx → api-gateway (recommended).
# WEB_API_BASE_URL=

# Compose pins PORT/GATEWAY_ADDR on api-gateway. PORT here helps if the platform
# injects env globally. Do NOT set GATEWAY_ADDR=127.0.0.1:8080.
PORT=8080

NATS_STARTUP_TIMEOUT_SEC=60
# Shared by auth-service (signs the access token) and both api-gateways (verify
# it). One value for all three: a mismatch 401s every authenticated route right
# after a successful login. Cross-check the `jwt_secret_fp` startup log lines.
JWT_SECRET=dev-jwt-secret-change-me
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000
INTERNAL_TOKEN=dev-internal-token-change-me
PHONE_ENC_KEY=dev-phone-enc-key-32bytes-min!!
PHONE_HASH_PEPPER=dev-phone-hash-pepper-change-me
OTP_HASH_PEPPER=dev-otp-hash-pepper-change-me
OTP_TTL_SEC=300
OTP_COOLDOWN_SEC=60
OTP_MAX_PER_PHONE_HOUR=5
OTP_MAX_PER_IP_HOUR=20
OTP_MAX_ATTEMPTS=5
# Keep 0 on any reachable host: 1 returns the OTP code in the API response,
# which lets anyone log in as any phone number. Set 1 only for a throwaway
# environment with no real users.
OTP_DEV_REVEAL=0

RATE_LIMIT_OTP_PER_IP_MINUTE=10
RATE_LIMIT_LOGIN_PER_IP_MINUTE=10
RATE_LIMIT_ORDER_PER_IP_MINUTE=30
RATE_LIMIT_ORDER_PER_USER_MINUTE=10

# Geocode — no ": " inside the value
GEOCODE_PROVIDER=photon
GEOCODE_USER_AGENT=GasTamDe/1.0 (local-dev; geo-service; contact=local)
GEOCODE_CACHE_TTL_HOURS=24
GEOCODE_MAX_PER_IP_MINUTE=30

STORE_SEED=1
STORE_NAME=Gas Tam Đệ
STORE_LAT=10.7769
STORE_LNG=106.7009
STORE_MAX_RADIUS_KM=10

DELIVERY_FEE_SEED=1
DELIVERY_FEE_ENABLED=0
INVENTORY_SEED=1

ADMIN_SEED=1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin-change-me
ADMIN_DISPLAY_NAME=Admin
# Numbers that get role=admin after a normal OTP login (comma-separated).
# Only ever adds; the list is then managed from Quản trị -> So dien thoai admin,
# and entries removed there are not restored on restart.
ADMIN_PHONES=0909777020

# SMS — only needed when SMS_PROVIDER=stringee (keep mock for staging unless testing real SMS)
SMS_PROVIDER=mock
# SMS_API_SID=
# SMS_API_SECRET=
# SMS_API_KEY=
# SMS_SENDER=
